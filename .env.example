# Environment Configuration Example
# Road Accident Hotspot Mapping - Team 12 (BRD-RAH-001)

# App Settings
PROJECT_NAME="Road Accident Hotspot Mapping"
ENVIRONMENT="development"
DEBUG=True
API_V1_PREFIX="/api/v1"
CORS_ORIGINS=["http://localhost:5173","http://localhost:3000","http://localhost:80","http://127.0.0.1:5173"]

# Security & JWT Auth
SECRET_KEY="replace-with-a-secure-random-secret-key-in-production-min-32-chars"
ALGORITHM="HS256"
ACCESS_TOKEN_EXPIRE_MINUTES=60
REFRESH_TOKEN_EXPIRE_DAYS=7

# PostgreSQL + PostGIS Database
POSTGRES_SERVER=localhost
POSTGRES_PORT=5432
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=road_safety
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/road_safety
# For async SQLAlchemy if used:
# DATABASE_URL_ASYNC=postgresql+asyncpg://postgres:postgres@localhost:5432/road_safety

# Redis (Cache, Sessions, Queued Analysis Tasks)
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_URL=redis://localhost:6379/0

# Object Storage (MinIO local / AWS S3)
MINIO_ENDPOINT=localhost:9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
MINIO_BUCKET=road-safety-imports
MINIO_REPORTS_BUCKET=road-safety-reports
MINIO_SECURE=False

# Geographic & Analytics Defaults (Hyderabad / Telangana NH-65 corridor)
DEMO_CENTER_LAT=17.4200
DEMO_CENTER_LON=78.5800
DEFAULT_SEARCH_RADIUS_M=250
DEFAULT_MIN_ACCIDENTS=5
DEFAULT_ANALYSIS_PERIOD_MONTHS=12

# LLM Provider for Grounded AI Assistant (gemini | openai | anthropic | offline)
LLM_PROVIDER=offline
GEMINI_API_KEY=
OPENAI_API_KEY=
ANTHROPIC_API_KEY=

# Nominatim / Geocoding
NOMINATIM_USER_AGENT=road-accident-hotspot-mapping-team12
NOMINATIM_CACHE_ENABLED=True
